DB_USERNAME=tik_agent
DB_PASSWORD=tik_agent
DB_ROOT_PASSWORD=root
MYSQL_PORT=3306
SERVER_PORT=8080
UI_PORT=5173
REDIS_PORT=6379

# Mock is the default and requires no model credentials.
TIK_AGENT_DEFAULT_MODEL=mock
TIK_AGENT_OPENAI_ENABLED=false
TIK_AGENT_OPENAI_BASE_URL=
TIK_AGENT_OPENAI_API_KEY=
TIK_AGENT_OPENAI_MODEL_NAME=
TIK_AGENT_OPENAI_TEMPERATURE=0.2

TIK_AGENT_GEMINI_ENABLED=false
TIK_AGENT_GEMINI_API_KEY=
TIK_AGENT_GEMINI_MODEL_NAME=gemini-2.5-flash

TIK_AGENT_MEMORY_MAX_MESSAGES=20
TIK_AGENT_MEMORY_TOKEN_BUDGET=4096
TIK_AGENT_MEMORY_EXPIRE_AFTER_ACCESS=30m
TIK_AGENT_MEMORY_MAXIMUM_SIZE=1000
TIK_AGENT_STREAM_CHECKPOINT_TOKEN_THRESHOLD=32
TIK_AGENT_STREAM_CHECKPOINT_INTERVAL=1s
TIK_AGENT_STREAM_EVENT_MAX_LENGTH=10000
TIK_AGENT_STREAM_EVENT_TTL=24h
TIK_AGENT_STREAM_MAX_OUTPUT_BYTES=1048576
TIK_AGENT_GENERATION_LEASE_TTL=30s
TIK_AGENT_GENERATION_LEASE_RENEW_INTERVAL=10s
TIK_AGENT_GENERATION_TIMEOUT=120s
TIK_AGENT_GENERATION_MAX_CONCURRENT_PER_INSTANCE=1
