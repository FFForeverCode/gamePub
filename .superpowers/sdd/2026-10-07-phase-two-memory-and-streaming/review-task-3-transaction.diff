+package com.gamepub.server.conversation;
+
+import java.time.LocalDateTime;
+import java.util.Objects;
+
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+@Service
+public class GenerationTerminalService {
+    private final GenerationMapper generationMapper;
+    private final MessageMapper messageMapper;
+
+    public GenerationTerminalService(GenerationMapper generationMapper, MessageMapper messageMapper) {
+        this.generationMapper = generationMapper;
+        this.messageMapper = messageMapper;
+    }
+
+    @Transactional
+    public void finish(String generationId, long fenceEpoch, GenerationStatus expectedStatus,
+                       GenerationStatus terminalStatus, String content, MessageStatus messageStatus,
+                       String errorCode, Long inputTokenCount, Long outputTokenCount) {
+        validateTerminalPair(terminalStatus, messageStatus);
+        ChatGeneration generation = generationMapper.findById(generationId);
+        if (generation == null || generation.getAssistantMessageId() == null) {
+            throw new IllegalStateException("Generation or assistant message is missing");
+        }
+
+        LocalDateTime now = LocalDateTime.now();
+        int generationUpdated = generationMapper.transitionIfCurrent(generationId, fenceEpoch, expectedStatus,
+                terminalStatus, errorCode, inputTokenCount, outputTokenCount, now);
+        if (generationUpdated != 1) {
+            throw new IllegalStateException("Generation is stale or no longer transitionable");
+        }
+
+        int messageUpdated = messageMapper.finishIfGenerationCurrent(generation.getAssistantMessageId(),
+                generationId, fenceEpoch, terminalStatus, content, messageStatus, errorCode, now);
+        if (messageUpdated != 1) {
+            throw new IllegalStateException("Assistant message is stale or no longer transitionable");
+        }
+    }
+
+    private void validateTerminalPair(GenerationStatus generationStatus, MessageStatus messageStatus) {
+        Objects.requireNonNull(generationStatus, "terminalStatus");
+        Objects.requireNonNull(messageStatus, "messageStatus");
+        MessageStatus expectedMessageStatus = switch (generationStatus) {
+            case COMPLETED -> MessageStatus.COMPLETED;
+            case FAILED, RETRYABLE -> MessageStatus.FAILED;
+            case CANCELLED -> MessageStatus.CANCELLED;
+            default -> throw new IllegalArgumentException("Generation status is not terminal");
+        };
+        if (messageStatus != expectedMessageStatus) {
+            throw new IllegalArgumentException("Generation and assistant message terminal states do not match");
+        }
+    }
+}
